//@version=5
strategy("Quotex AI 6-Pillar Confluence Scalping Strategy", shorttitle="Quotex AI 6-Pillar Scalper", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.01)

// ==========================================
// 1. INPUT SETTINGS & PARAMETERS
// ==========================================
// --- EMA Settings ---
grp_ema     = "EMA Settings"
fastEmaLen  = input.int(9, title="Fast EMA Length", minval=1, group=grp_ema)
slowEmaLen  = input.int(21, title="Slow EMA Length", minval=1, group=grp_ema)
trendEmaLen = input.int(200, title="Major Trend EMA Length", minval=1, group=grp_ema)

// --- ADX Settings ---
grp_adx     = "ADX Settings (Trend Strength Filter)"
adxLen      = input.int(14, title="ADX Smoothing Length", minval=1, group=grp_adx)
diLen       = input.int(14, title="DI Length", minval=1, group=grp_adx)
adxThresh   = input.int(25, title="Minimum ADX Threshold (Avoid Sideways)", minval=10, maxval=50, group=grp_adx)

// --- Bollinger Bands Settings ---
grp_bb      = "Bollinger Bands Settings"
bbLen       = input.int(20, title="Bollinger Bands Length", minval=1, group=grp_bb)
bbMult      = input.float(2.0, title="Bollinger Bands StdDev", minval=0.5, step=0.1, group=grp_bb)

// --- RSI Settings ---
grp_rsi     = "RSI Settings"
rsiLen      = input.int(14, title="RSI Length", minval=1, group=grp_rsi)
rsiOversold = input.int(30, title="RSI Oversold Level (Buy Zone)", minval=1, maxval=50, group=grp_rsi)
rsiOverbought = input.int(70, title="RSI Overbought Level (Sell Zone)", minval=50, maxval=99, group=grp_rsi)
rsiLookback = input.int(5, title="RSI Trigger Lookback (Bars)", minval=1, maxval=20, group=grp_rsi)

// --- Risk Management & Execution ---
grp_risk    = "Risk Management (TP / SL)"
useAtrSl    = input.bool(true, title="Use ATR for Dynamic Stop Loss", group=grp_risk)
atrLen      = input.int(14, title="ATR Length", group=grp_risk)
atrSlMult   = input.float(1.5, title="ATR Stop Loss Multiplier", step=0.1, group=grp_risk)
rrRatio     = input.float(1.5, title="Risk-to-Reward Ratio (TP = SL * RR)", step=0.1, group=grp_risk)

// ==========================================
// 2. INDICATOR CALCULATIONS
// ==========================================
// EMAs
fastEma  = ta.ema(close, fastEmaLen)
slowEma  = ta.ema(close, slowEmaLen)
trendEma = ta.ema(close, trendEmaLen)

// ADX Calculation
[plusDI, minusDI, adxValue] = ta.dmi(diLen, adxLen)

// Bollinger Bands Calculation
[bbMiddle, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)

// RSI Calculation
rsiValue = ta.rsi(close, rsiLen)

// ATR Calculation
atrValue = ta.atr(atrLen)

// ==========================================
// 3. STRICT 6-PILLAR CONFLUENCE LOGIC
// ==========================================
// 1. Major Trend Filter (EMA 200)
bullishTrend = close > trendEma
bearishTrend = close < trendEma

// 2. Trend Strength Filter (ADX > 25)
strongTrend  = adxValue >= adxThresh

// 3. EMA Crossover
emaBullCross = ta.crossover(fastEma, slowEma) or (fastEma > slowEma and ta.crossover(close, fastEma))
emaBearCross = ta.crossunder(fastEma, slowEma) or (fastEma < slowEma and ta.crossunder(close, fastEma))

// 4. RSI Condition
rsiWasOversold   = ta.lowest(rsiValue, rsiLookback) <= rsiOversold
rsiWasOverbought = ta.highest(rsiValue, rsiLookback) >= rsiOverbought
rsiBuyValid      = rsiValue <= 45 and (rsiWasOversold or rsiValue <= rsiOversold)
rsiSellValid     = rsiValue >= 55 and (rsiWasOverbought or rsiValue >= rsiOverbought)

// 5. Bollinger Band Bounce / Rejection
bbBuyValid  = low <= bbLower or close[1] <= bbLower
bbSellValid = high >= bbUpper or close[1] >= bbUpper

// Combined 6-Pillar Buy / Sell Conditions
buyCondition  = bullishTrend and strongTrend and emaBullCross and rsiBuyValid and bbBuyValid
sellCondition = bearishTrend and strongTrend and emaBearCross and rsiSellValid and bbSellValid

// ==========================================
// 4. PLOTS & VISUAL ANNOTATIONS
// ==========================================
// Plot EMAs
plot(fastEma, title="EMA 9 (Fast)", color=color.new(#00E5FF, 0), linewidth=2)
plot(slowEma, title="EMA 21 (Slow)", color=color.new(#FF9100, 0), linewidth=2)
plot(trendEma, title="EMA 200 (Major Trend)", color=color.new(#FF1744, 0), linewidth=3)

// Plot Bollinger Bands
plot(bbUpper, title="Upper BB", color=color.new(#FF1744, 50), linewidth=1)
plot(bbLower, title="Lower BB", color=color.new(#00E676, 50), linewidth=1)
fill(plot(bbUpper), plot(bbLower), color=color.new(#00E5FF, 95), title="BB Channel Fill")

// Plot Buy / Sell Arrows on Chart
plotshape(buyCondition, title="BUY Signal Arrow", style=shape.triangleup, location=location.belowbar, color=color.new(#00E676, 0), size=size.normal, text="BUY 90%+", textcolor=color.white)
plotshape(sellCondition, title="SELL Signal Arrow", style=shape.triangledown, location=location.abovebar, color=color.new(#FF1744, 0), size=size.normal, text="SELL 90%+", textcolor=color.white)

// Background highlight on signal
bgcolor(buyCondition ? color.new(#00E676, 85) : sellCondition ? color.new(#FF1744, 85) : na, title="Signal Background Highlight")

// ==========================================
// 5. STRATEGY EXECUTION & RISK MANAGEMENT
// ==========================================
var float longSlPrice  = na
var float longTpPrice  = na
var float shortSlPrice = na
var float shortTpPrice = na

slDistance = atrValue * atrSlMult
tpDistance = slDistance * rrRatio

if buyCondition
    longSlPrice := close - slDistance
    longTpPrice := close + tpDistance
    strategy.entry("AI_Long", strategy.long, comment="BUY [6-Pillar]")
    strategy.exit("Exit_Long", from_entry="AI_Long", stop=longSlPrice, limit=longTpPrice, comment_loss="SL Hit", comment_profit="TP Hit")

if sellCondition
    shortSlPrice := close + slDistance
    shortTpPrice := close - tpDistance
    strategy.entry("AI_Short", strategy.short, comment="SELL [6-Pillar]")
    strategy.exit("Exit_Short", from_entry="AI_Short", stop=shortSlPrice, limit=shortTpPrice, comment_loss="SL Hit", comment_profit="TP Hit")

// ==========================================
// 6. TRADINGVIEW WEBHOOK / ALERT CONDITIONS
// ==========================================
alertcondition(buyCondition, title="Quotex AI BUY Alert", message="QUOTEX 90%+ BUY SIGNAL! EMA 200 Trend + ADX>25 + EMA 9/21 + RSI + BB Lower Bounce @ {{close}}")
alertcondition(sellCondition, title="Quotex AI SELL Alert", message="QUOTEX 90%+ SELL SIGNAL! EMA 200 Trend + ADX>25 + EMA 9/21 + RSI + BB Upper Rejection @ {{close}}")

